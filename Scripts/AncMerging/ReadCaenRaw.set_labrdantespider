#window: width of the time window used for the event building (in ns)
window 500

#boardDef:
# arg 1: boardId
# arg 2 :boardVersion(V1725/V1730==1 - VX2740 ==2)
# arg 3 :number of channels
# arg 4: FWVersion (PHA or PSD)
# arg 5: ns per timestamp
# arg 6: ns per sample
# arg 7: data key: 0xFA0201A2 = SPIDER ; LABR = 0xFA0201A5 ; DANTE = 0x
boardDef 0 1 16 PSD 2 2 labr
boardDef 1 2 64 PHA 8 8 spider
boardDef 5 1 16 PHA 4 4 dante


#minFold:
# arg 1: minFold for this detector
# arg 2: keep only events if coincidence with other board
minFold 2 0
minFold 1 0
minFold 1 0


