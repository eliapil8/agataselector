#window: width of the time window used for the event building (in ns)
window 500

#boardDef:
# arg 1: boardId
# arg 2 :boardVersion(V1725/V1730==1 - VX2740 ==2)
# arg 3 :number of channels
# arg 4: FWVersion (PHA or PSD)
# arg 5: ns per timestamp
# arg 6: ns per sample
# arg 7: data key: 0xFA0201A2 = SPIDER ; LABR = 0xFA0201A5 ; DANTE = 0x
board 1 1 16 PSD 2 2 labr

#minFold:
# arg 1: detector
# arg 2: minFold for this detector
# arg 3: keep only events if coincidence with other board
minfold 1 0

# board   channel   timeOffset
tsoffset 1 0 130
tsoffset 1 1 130
tsoffset 1 2 130
tsoffset 1 3 130
tsoffset 1 4 130
tsoffset 1 5 130
tsoffset 1 6 130
tsoffset 1 7 130
tsoffset 1 8 130
tsoffset 1 9 130
tsoffset 1 10 130
tsoffset 1 11 130
tsoffset 1 12 130
tsoffset 1 13 130
tsoffset 1 14 130
tsoffset 1 15 130
#minfold 1 2
